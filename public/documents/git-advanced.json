{
  "title": "Git 进阶工具 (Advanced Operations)",
  "description": "Git 系列进阶操作：interactive rebase、bisect、worktree、submodule、clean、hooks 等复杂场景",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "交互式变基最近 3 次提交", "content": "git rebase -i HEAD~3" },
    { "type": "text", "tips": "解决完冲突，继续变基", "content": "git rebase --continue" },
    { "type": "text", "tips": "开始二分查找定位 bug", "content": "git bisect start" },
    { "type": "text", "tips": "标记当前提交为有问题", "content": "git bisect bad" },
    { "type": "text", "tips": "标记提交 abc123 为正常", "content": "git bisect good abc123" },
    { "type": "text", "tips": "结束二分查找，回到原分支", "content": "git bisect reset" },
    { "type": "text", "tips": "在 ../tmp 目录为分支 dev 建工作树", "content": "git worktree add ../tmp dev" },
    { "type": "text", "tips": "列出所有工作树", "content": "git worktree list" },
    { "type": "text", "tips": "移除工作树 ../tmp", "content": "git worktree remove ../tmp" },
    { "type": "text", "tips": "把 git@github.com:u/lib.git 作为子模块加到 libs 目录", "content": "git submodule add git@github.com:u/lib.git libs" },
    { "type": "text", "tips": "递归初始化并更新所有子模块", "content": "git submodule update --init --recursive" },
    { "type": "text", "tips": "强制清除未跟踪的文件和目录", "content": "git clean -fd" },
    { "type": "text", "tips": "把 .env 移出版本控制但保留本地文件", "content": "git rm --cached .env" },
    { "type": "text", "tips": "用 npx 安装 husky 钩子", "content": "npx husky install" },
    { "type": "text", "tips": "用 npx husky add 在 .husky/pre-commit 加钩子执行 npm test", "content": "npx husky add .husky/pre-commit \"npm test\"" }
  ]
}
