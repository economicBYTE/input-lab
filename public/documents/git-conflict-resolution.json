{
  "title": "Git 冲突解决 (Conflict Resolution)",
  "description": "Git 系列冲突处理：定位冲突文件、查看 ours/theirs 差异、选择版本、标记解决，并继续或中止 merge/rebase/cherry-pick/revert",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "查看当前冲突状态", "content": "git status" },
    { "type": "text", "tips": "列出未合并的冲突文件", "content": "git diff --name-only --diff-filter=U" },
    { "type": "text", "tips": "查看冲突区域差异", "content": "git diff" },
    { "type": "text", "tips": "查看 ours 版本差异", "content": "git diff --ours" },
    { "type": "text", "tips": "查看 theirs 版本差异", "content": "git diff --theirs" },
    { "type": "text", "tips": "查看共同祖先版本(base)", "content": "git diff --base" },
    { "type": "text", "tips": "列出冲突文件的暂存区阶段", "content": "git ls-files -u" },
    { "type": "text", "tips": "查看冲突相关提交", "content": "git log --merge --oneline" },
    { "type": "text", "tips": "保留 ours 版本解决文件冲突", "content": "git restore --ours src/index.ts" },
    { "type": "text", "tips": "保留 theirs 版本解决文件冲突", "content": "git restore --theirs src/index.ts" },
    { "type": "text", "tips": "手动编辑后标记冲突已解决", "content": "git add src/index.ts" },
    { "type": "text", "tips": "检查解决后是否有空白错误", "content": "git diff --check" },
    { "type": "text", "tips": "继续合并流程", "content": "git merge --continue" },
    { "type": "text", "tips": "中止合并并回到合并前状态", "content": "git merge --abort" },
    { "type": "text", "tips": "继续变基流程", "content": "git rebase --continue" },
    { "type": "text", "tips": "跳过当前变基提交", "content": "git rebase --skip" },
    { "type": "text", "tips": "中止变基并回到变基前状态", "content": "git rebase --abort" },
    { "type": "text", "tips": "继续拣选流程", "content": "git cherry-pick --continue" },
    { "type": "text", "tips": "中止拣选并回到操作前状态", "content": "git cherry-pick --abort" },
    { "type": "text", "tips": "继续反向提交流程", "content": "git revert --continue" },
    { "type": "text", "tips": "中止反向提交流程", "content": "git revert --abort" },
    { "type": "text", "tips": "启动外部合并工具", "content": "git mergetool" },
    { "type": "text", "tips": "启用冲突解决复用", "content": "git config --global rerere.enabled true" },
    { "type": "text", "tips": "查看可复用的冲突解决记录", "content": "git rerere status" },
    { "type": "text", "tips": "查看 rerere 记录的解决差异", "content": "git rerere diff" }
  ]
}
