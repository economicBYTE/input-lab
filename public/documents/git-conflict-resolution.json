{
  "title": "Git 冲突解决 (Conflict Resolution)",
  "description": "Git 系列冲突处理：定位冲突文件、查看 ours/theirs 差异、选择版本、标记解决，并继续或中止 merge/rebase/cherry-pick/revert",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "查看当前冲突状态", "content": "git status" },
    { "type": "text", "tips": "只列出未合并（U 状态）的冲突文件名", "content": "git diff --name-only --diff-filter=U" },
    { "type": "text", "tips": "查看冲突区域差异", "content": "git diff" },
    { "type": "text", "tips": "只看与 ours 版本的差异", "content": "git diff --ours" },
    { "type": "text", "tips": "只看与 theirs 版本的差异", "content": "git diff --theirs" },
    { "type": "text", "tips": "只看与共同祖先 base 版本的差异", "content": "git diff --base" },
    { "type": "text", "tips": "列出冲突文件在暂存区的各个阶段", "content": "git ls-files -u" },
    { "type": "text", "tips": "单行查看两边独有的冲突相关提交", "content": "git log --merge --oneline" },
    { "type": "text", "tips": "a.ts 保留 ours 版本", "content": "git restore --ours a.ts" },
    { "type": "text", "tips": "a.ts 保留 theirs 版本", "content": "git restore --theirs a.ts" },
    { "type": "text", "tips": "手动改完后，把 a.ts 标记为已解决", "content": "git add a.ts" },
    { "type": "text", "tips": "检查解决结果有没有空白字符错误", "content": "git diff --check" },
    { "type": "text", "tips": "解决完冲突，继续合并", "content": "git merge --continue" },
    { "type": "text", "tips": "中止合并，回到合并前状态", "content": "git merge --abort" },
    { "type": "text", "tips": "解决完冲突，继续变基", "content": "git rebase --continue" },
    { "type": "text", "tips": "跳过当前这个变基提交", "content": "git rebase --skip" },
    { "type": "text", "tips": "中止变基，回到变基前状态", "content": "git rebase --abort" },
    { "type": "text", "tips": "解决完冲突，继续拣选", "content": "git cherry-pick --continue" },
    { "type": "text", "tips": "中止拣选，回到操作前状态", "content": "git cherry-pick --abort" },
    { "type": "text", "tips": "解决完冲突，继续反向提交", "content": "git revert --continue" },
    { "type": "text", "tips": "中止反向提交，回到操作前状态", "content": "git revert --abort" },
    { "type": "text", "tips": "启动外部合并工具", "content": "git mergetool" },
    { "type": "text", "tips": "全局开启冲突解决复用 rerere", "content": "git config --global rerere.enabled true" },
    { "type": "text", "tips": "查看 rerere 记录的状态", "content": "git rerere status" },
    { "type": "text", "tips": "查看 rerere 记录的解决差异", "content": "git rerere diff" }
  ]
}
