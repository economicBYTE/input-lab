{
  "title": "Git 分支与合并 (Branch & Merge)",
  "description": "Git 系列分支协作：branch/switch/checkout、merge、rebase、cherry-pick 与分支删除",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "列出本地分支", "content": "git branch" },
    { "type": "text", "tips": "列出所有分支（含远程）", "content": "git branch -a" },
    { "type": "text", "tips": "创建分支 dev，但不切过去", "content": "git branch dev" },
    { "type": "text", "tips": "把当前分支重命名为 dev", "content": "git branch -m dev" },
    { "type": "text", "tips": "安全删除已合并的本地分支 dev", "content": "git branch -d dev" },
    { "type": "text", "tips": "强制删除本地分支 dev（未合并也删）", "content": "git branch -D dev" },
    { "type": "text", "tips": "删除 origin 上的远程分支 dev", "content": "git push origin --delete dev" },
    { "type": "text", "tips": "用 checkout 切换到 main 分支", "content": "git checkout main" },
    { "type": "text", "tips": "用 checkout 创建并切换到 dev 分支", "content": "git checkout -b dev" },
    { "type": "text", "tips": "用 switch 切换到 main 分支", "content": "git switch main" },
    { "type": "text", "tips": "用 switch 创建并切换到 dev 分支", "content": "git switch -c dev" },
    { "type": "text", "tips": "把 dev 合并到当前分支", "content": "git merge dev" },
    { "type": "text", "tips": "把 dev 非快进合并到当前分支（保留合并提交）", "content": "git merge --no-ff dev" },
    { "type": "text", "tips": "把当前分支变基到 main", "content": "git rebase main" },
    { "type": "text", "tips": "中止变基，回到变基前状态", "content": "git rebase --abort" },
    { "type": "text", "tips": "把提交 abc123 拣选到当前分支", "content": "git cherry-pick abc123" },
    { "type": "text", "tips": "拣选 abc123 并在信息里保留原提交引用", "content": "git cherry-pick -x abc123" },
    { "type": "text", "tips": "中止拣选，回到操作前状态", "content": "git cherry-pick --abort" }
  ]
}
