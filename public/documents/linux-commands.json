{
  "title": "Linux 常用命令 (Common Commands)",
  "description": "Linux/Ubuntu 服务器日常运维高频命令：文件操作、进程端口、服务管理、SSH 与 Docker",
  "category": "Linux",
  "content": [
    { "type": "text", "tips": "详细列表，大小用人类可读单位", "content": "ls -lh" },
    { "type": "text", "tips": "用 ll 列出所有文件（含隐藏）", "content": "ll -a" },
    { "type": "text", "tips": "返回上级目录", "content": "cd .." },
    { "type": "text", "tips": "打印当前所在路径", "content": "pwd" },
    { "type": "text", "tips": "递归创建目录 logs/tmp", "content": "mkdir -p logs/tmp" },
    { "type": "text", "tips": "把目录 src 递归复制到 /tmp", "content": "cp -r src /tmp" },
    { "type": "text", "tips": "查看文件 a.conf 的内容", "content": "cat a.conf" },
    { "type": "text", "tips": "实时跟踪 app.log 的末尾输出", "content": "tail -f app.log" },
    { "type": "text", "tips": "在 logs 目录递归搜索 ERROR 并显示行号", "content": "grep -rn \"ERROR\" logs" },
    { "type": "text", "tips": "在当前目录按名字查找所有 .log 文件", "content": "find . -name \"*.log\"" },
    { "type": "text", "tips": "查看磁盘空间，人类可读单位", "content": "df -h" },
    { "type": "text", "tips": "查看 logs 下各子项占用大小（汇总）", "content": "du -sh logs/*" },
    { "type": "text", "tips": "给 run.sh 加可执行权限", "content": "chmod +x run.sh" },
    { "type": "text", "tips": "建软链接 /opt/app 指向 /data/app", "content": "ln -s /data/app /opt/app" },
    { "type": "text", "tips": "建硬链接 /tmp/a.log 指向 /data/a.log", "content": "ln /data/a.log /tmp/a.log" },
    { "type": "text", "tips": "强制覆盖软链接 /opt/app 指向 /data/v2", "content": "ln -sfn /data/v2 /opt/app" },
    { "type": "text", "tips": "查看 /opt/app 软链接的真实路径", "content": "readlink -f /opt/app" },
    { "type": "text", "tips": "把 a.conf 移动到 tmp 目录", "content": "mv a.conf tmp" },
    { "type": "text", "tips": "用 sudo 强制删除当前目录下所有 .pem 文件", "content": "sudo rm -rf *.pem" },
    { "type": "text", "tips": "在进程列表中查找 nginx", "content": "ps aux | grep nginx" },
    { "type": "text", "tips": "用 sudo 查看 443 端口被谁占用", "content": "sudo lsof -i:443" },
    { "type": "text", "tips": "用 sudo 强制杀死进程 1234", "content": "sudo kill -9 1234" },
    { "type": "text", "tips": "用 sudo 重启 nginx 服务", "content": "sudo systemctl restart nginx" },
    { "type": "text", "tips": "用 sudo 让 nginx 重载配置（不重启）", "content": "sudo nginx -s reload" },
    { "type": "text", "tips": "用密钥 ~/.ssh/id_rsa 登录 root@1.2.3.4", "content": "ssh -i ~/.ssh/id_rsa root@1.2.3.4" },
    { "type": "text", "tips": "把本机公钥复制到 root@1.2.3.4", "content": "ssh-copy-id root@1.2.3.4" },
    { "type": "text", "tips": "进入容器 abc123 的 sh 交互终端", "content": "docker exec -it abc123 sh" },
    { "type": "text", "tips": "实时跟踪容器 abc123 最后 100 行日志", "content": "docker logs --tail 100 -f abc123" }
  ]
}
