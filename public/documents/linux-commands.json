{
  "title": "Linux 常用命令 (Common Commands)",
  "description": "Linux/Ubuntu 服务器日常运维高频命令:文件操作、进程端口、服务管理、SSH 与 Docker",
  "category": "Linux",
  "content": [
    { "type": "text", "tips": "详细列表(人类可读)", "content": "ls -lh" },
    { "type": "text", "tips": "显示所有文件含隐藏", "content": "ll -a" },
    { "type": "text", "tips": "返回上级目录", "content": "cd .." },
    { "type": "text", "tips": "显示当前路径", "content": "pwd" },
    { "type": "text", "tips": "递归创建目录", "content": "mkdir -p logs/2026" },
    { "type": "text", "tips": "递归复制目录", "content": "cp -r src/ /tmp/backup/" },
    { "type": "text", "tips": "查看文件内容", "content": "cat shu-huang-dian.conf" },
    { "type": "text", "tips": "实时查看日志末尾", "content": "tail -f error.log" },
    { "type": "text", "tips": "递归搜索关键字", "content": "grep -rn \"ERROR\" ./logs" },
    { "type": "text", "tips": "按文件名查找", "content": "find . -name \"*.log\"" },
    { "type": "text", "tips": "查看磁盘空间", "content": "df -h" },
    { "type": "text", "tips": "查看子目录占用", "content": "du -sh /var/log/*" },
    { "type": "text", "tips": "添加可执行权限", "content": "chmod +x deploy.sh" },
    { "type": "text", "tips": "移动或重命名文件", "content": "mv shu-huang-dian.conf ./history/" },
    { "type": "text", "tips": "强制删除文件", "content": "sudo rm -rf ./*.pem" },
    { "type": "text", "tips": "查找进程", "content": "ps aux | grep nginx" },
    { "type": "text", "tips": "查看端口占用", "content": "sudo lsof -i:443" },
    { "type": "text", "tips": "强制终止进程", "content": "sudo kill -9 385177" },
    { "type": "text", "tips": "重启系统服务", "content": "sudo systemctl restart nginx" },
    { "type": "text", "tips": "重载 nginx 配置", "content": "sudo nginx -s reload" },
    { "type": "text", "tips": "SSH 登录(指定 key)", "content": "ssh -i ~/.ssh/backup_key ubuntu@124.222.230.225" },
    { "type": "text", "tips": "复制 SSH 公钥到远端", "content": "ssh-copy-id root@101.132.250.203" },
    { "type": "text", "tips": "进入容器 shell", "content": "docker exec -it 9b3be913c499 sh" },
    { "type": "text", "tips": "实时查看容器日志", "content": "docker logs --tail 100 -f 5f11a4b5eeed" }
  ]
}
