{
  "title": "SQL 函数基础",
  "description": "SQL 常用函数练习：字符串、数值、日期、聚合、条件与类型转换函数的多种写法",
  "category": "SQL",
  "caseInsensitive": true,
  "content": [
    { "type": "text", "tips": "CONCAT 字符串拼接", "content": "SELECT CONCAT('Hello', ' ', 'World') AS greeting;" },
    { "type": "text", "tips": "CONCAT 拼接列", "content": "SELECT CONCAT(first_name, ' ', last_name) AS full_name FROM users;" },
    { "type": "text", "tips": "CONCAT_WS 指定分隔符拼接", "content": "SELECT CONCAT_WS('-', '2026', '04', '14') AS date_str;" },
    { "type": "text", "tips": "LENGTH 字节长度", "content": "SELECT LENGTH('hello world');" },
    { "type": "text", "tips": "CHAR_LENGTH 字符长度", "content": "SELECT CHAR_LENGTH(name) FROM users WHERE id = 1;" },
    { "type": "text", "tips": "UPPER 转大写", "content": "SELECT UPPER(email) FROM users;" },
    { "type": "text", "tips": "LOWER 转小写", "content": "SELECT LOWER('HELLO') AS lower_text;" },
    { "type": "text", "tips": "SUBSTRING 截取从指定位置", "content": "SELECT SUBSTRING('abcdefg', 2);" },
    { "type": "text", "tips": "SUBSTRING 截取指定长度", "content": "SELECT SUBSTRING('abcdefg', 2, 3);" },
    { "type": "text", "tips": "SUBSTR 等价写法", "content": "SELECT SUBSTR(name, 1, 3) FROM users;" },
    { "type": "text", "tips": "LEFT 取左侧字符", "content": "SELECT LEFT('abcdefg', 3);" },
    { "type": "text", "tips": "RIGHT 取右侧字符", "content": "SELECT RIGHT('abcdefg', 3);" },
    { "type": "text", "tips": "REPLACE 替换字符串", "content": "SELECT REPLACE('hello world', 'world', 'SQL');" },
    { "type": "text", "tips": "TRIM 去除两侧空格", "content": "SELECT TRIM('  hello  ');" },
    { "type": "text", "tips": "LTRIM 去除左侧空格", "content": "SELECT LTRIM('   hello');" },
    { "type": "text", "tips": "RTRIM 去除右侧空格", "content": "SELECT RTRIM('hello   ');" },
    { "type": "text", "tips": "LPAD 左侧补齐", "content": "SELECT LPAD('5', 3, '0');" },
    { "type": "text", "tips": "RPAD 右侧补齐", "content": "SELECT RPAD('abc', 6, '*');" },
    { "type": "text", "tips": "INSTR 查找子串位置", "content": "SELECT INSTR('hello world', 'world');" },
    { "type": "text", "tips": "LOCATE 等价写法", "content": "SELECT LOCATE('o', 'hello world', 5);" },
    { "type": "text", "tips": "REVERSE 字符串反转", "content": "SELECT REVERSE('abcdef');" },

    { "type": "text", "tips": "ROUND 四舍五入", "content": "SELECT ROUND(3.14159);" },
    { "type": "text", "tips": "ROUND 保留小数位", "content": "SELECT ROUND(3.14159, 2);" },
    { "type": "text", "tips": "CEIL 向上取整", "content": "SELECT CEIL(3.14);" },
    { "type": "text", "tips": "FLOOR 向下取整", "content": "SELECT FLOOR(3.99);" },
    { "type": "text", "tips": "TRUNCATE 截断小数", "content": "SELECT TRUNCATE(3.14159, 2);" },
    { "type": "text", "tips": "ABS 绝对值", "content": "SELECT ABS(-42);" },
    { "type": "text", "tips": "MOD 取余", "content": "SELECT MOD(10, 3);" },
    { "type": "text", "tips": "MOD 运算符写法", "content": "SELECT 10 % 3 AS remainder;" },
    { "type": "text", "tips": "POWER 幂运算", "content": "SELECT POWER(2, 10);" },
    { "type": "text", "tips": "SQRT 平方根", "content": "SELECT SQRT(144);" },
    { "type": "text", "tips": "RAND 随机数", "content": "SELECT RAND();" },

    { "type": "text", "tips": "NOW 当前日期时间", "content": "SELECT NOW();" },
    { "type": "text", "tips": "CURDATE 当前日期", "content": "SELECT CURDATE();" },
    { "type": "text", "tips": "CURTIME 当前时间", "content": "SELECT CURTIME();" },
    { "type": "text", "tips": "DATE_FORMAT 格式化日期", "content": "SELECT DATE_FORMAT(NOW(), '%Y-%m-%d %H:%i:%s');" },
    { "type": "text", "tips": "DATE_FORMAT 自定义格式", "content": "SELECT DATE_FORMAT(created_at, '%Y/%m/%d') FROM orders;" },
    { "type": "text", "tips": "DATE_ADD 增加天数", "content": "SELECT DATE_ADD(NOW(), INTERVAL 7 DAY);" },
    { "type": "text", "tips": "DATE_ADD 增加月份", "content": "SELECT DATE_ADD('2026-04-14', INTERVAL 1 MONTH);" },
    { "type": "text", "tips": "DATE_SUB 减少天数", "content": "SELECT DATE_SUB(CURDATE(), INTERVAL 30 DAY);" },
    { "type": "text", "tips": "DATEDIFF 相差天数", "content": "SELECT DATEDIFF('2026-12-31', '2026-01-01');" },
    { "type": "text", "tips": "YEAR 提取年", "content": "SELECT YEAR(created_at) FROM orders;" },
    { "type": "text", "tips": "MONTH 提取月", "content": "SELECT MONTH('2026-04-14');" },
    { "type": "text", "tips": "DAY 提取日", "content": "SELECT DAY(NOW());" },
    { "type": "text", "tips": "EXTRACT 提取部分", "content": "SELECT EXTRACT(YEAR FROM NOW());" },
    { "type": "text", "tips": "UNIX_TIMESTAMP 转时间戳", "content": "SELECT UNIX_TIMESTAMP('2026-04-14 12:00:00');" },
    { "type": "text", "tips": "FROM_UNIXTIME 时间戳转日期", "content": "SELECT FROM_UNIXTIME(1700000000);" },

    { "type": "text", "tips": "COUNT 全部行数", "content": "SELECT COUNT(*) FROM users;" },
    { "type": "text", "tips": "COUNT DISTINCT 去重计数", "content": "SELECT COUNT(DISTINCT city) FROM users;" },
    { "type": "text", "tips": "SUM 条件求和", "content": "SELECT SUM(amount) FROM orders WHERE status = 'paid';" },
    { "type": "text", "tips": "AVG 平均值保留2位", "content": "SELECT ROUND(AVG(price), 2) FROM products;" },
    { "type": "text", "tips": "MAX 最大值", "content": "SELECT MAX(created_at) FROM logs;" },
    { "type": "text", "tips": "MIN 最小值", "content": "SELECT MIN(price) FROM products;" },
    { "type": "text", "tips": "GROUP_CONCAT 分组拼接", "content": "SELECT user_id, GROUP_CONCAT(tag) FROM user_tags GROUP BY user_id;" },
    { "type": "text", "tips": "GROUP_CONCAT 自定义分隔符", "content": "SELECT GROUP_CONCAT(name SEPARATOR ' | ') FROM users;" },

    { "type": "text", "tips": "IF 条件判断", "content": "SELECT IF(age >= 18, 'adult', 'minor') FROM users;" },
    { "type": "text", "tips": "IFNULL 空值替换", "content": "SELECT IFNULL(email, 'unknown') FROM users;" },
    { "type": "text", "tips": "NULLIF 相等返回NULL", "content": "SELECT NULLIF(score, 0) FROM exams;" },
    { "type": "text", "tips": "COALESCE 多值取首个非空", "content": "SELECT COALESCE(nickname, name, 'guest') FROM users;" },
    { "type": "text", "tips": "CASE WHEN 简单判断", "content": "SELECT CASE WHEN age < 18 THEN 'minor' ELSE 'adult' END FROM users;" },
    { "type": "text", "tips": "CASE WHEN 多分支", "content": "SELECT CASE WHEN score >= 90 THEN 'A' WHEN score >= 60 THEN 'B' ELSE 'C' END FROM exams;" },
    { "type": "text", "tips": "CASE 字段匹配", "content": "SELECT CASE status WHEN 1 THEN 'active' WHEN 0 THEN 'inactive' ELSE 'unknown' END FROM users;" },

    { "type": "text", "tips": "CAST 类型转换", "content": "SELECT CAST('123' AS UNSIGNED);" },
    { "type": "text", "tips": "CAST 转 DECIMAL", "content": "SELECT CAST(price AS DECIMAL(10,2)) FROM products;" },
    { "type": "text", "tips": "CONVERT 类型转换", "content": "SELECT CONVERT('2026-04-14', DATE);" }
  ]
}
