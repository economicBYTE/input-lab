{
  "title": "Mac Chrome 浏览器快捷键",
  "description": "macOS Chrome 常用快捷键：标签页、窗口、地址栏与网页操作。这些组合键浏览器拦截不到，所以全部以文字形式练习，统一写成「Cmd + T」这种「按键 + 按键」形式，修饰键按 Cmd / Shift / Option / Ctrl 的顺序书写",
  "category": "快捷键",
  "content": [
    { "type": "text", "tips": "打开新标签页", "content": "Cmd + T" },
    { "type": "text", "tips": "关闭当前标签页", "content": "Cmd + W" },
    { "type": "text", "tips": "重新打开刚关掉的标签页", "content": "Cmd + Shift + T" },
    { "type": "text", "tips": "跳到下一个标签页", "content": "Cmd + Option + Right" },
    { "type": "text", "tips": "跳到上一个标签页", "content": "Cmd + Option + Left" },
    { "type": "text", "tips": "跳到第 1 个标签页", "content": "Cmd + 1" },
    { "type": "text", "tips": "跳到第 2 个标签页", "content": "Cmd + 2" },
    { "type": "text", "tips": "跳到第 3 个标签页", "content": "Cmd + 3" },
    { "type": "text", "tips": "跳到最后一个标签页", "content": "Cmd + 9" },

    { "type": "text", "tips": "打开新窗口", "content": "Cmd + N" },
    { "type": "text", "tips": "打开无痕窗口", "content": "Cmd + Shift + N" },
    { "type": "text", "tips": "关闭当前窗口（不是标签页）", "content": "Cmd + Shift + W" },
    { "type": "text", "tips": "最小化窗口", "content": "Cmd + M" },
    { "type": "text", "tips": "隐藏 Chrome", "content": "Cmd + H" },
    { "type": "text", "tips": "退出 Chrome", "content": "Cmd + Q" },

    { "type": "text", "tips": "光标跳到地址栏", "content": "Cmd + L" },
    { "type": "text", "tips": "给地址栏内容自动补上 www. 和 .com", "content": "Ctrl + Return" },

    { "type": "text", "tips": "在当前页查找内容", "content": "Cmd + F" },
    { "type": "text", "tips": "打开开发者工具", "content": "Cmd + Option + I" },
    { "type": "text", "tips": "直接打开 JavaScript 控制台", "content": "Cmd + Option + J" },
    { "type": "text", "tips": "打开历史记录页", "content": "Cmd + Y" },
    { "type": "text", "tips": "打开下载内容页", "content": "Cmd + Shift + J" },
    { "type": "text", "tips": "显示或隐藏书签栏", "content": "Cmd + Shift + B" },
    { "type": "text", "tips": "打开设置页", "content": "Cmd + ," },
    { "type": "text", "tips": "开启拆分视图", "content": "Cmd + Option + N" },

    { "type": "text", "tips": "打印当前网页", "content": "Cmd + P" },
    { "type": "text", "tips": "保存当前网页", "content": "Cmd + S" },
    { "type": "text", "tips": "放大网页", "content": "Cmd + +" },
    { "type": "text", "tips": "缩小网页", "content": "Cmd + -" },
    { "type": "text", "tips": "重置网页缩放到 100%", "content": "Cmd + 0" },
    { "type": "text", "tips": "刷新当前页", "content": "Cmd + R" },
    { "type": "text", "tips": "强制刷新（忽略缓存）", "content": "Cmd + Shift + R" },
    { "type": "text", "tips": "后退一页（用方括号）", "content": "Cmd + [" },
    { "type": "text", "tips": "前进一页（用方括号）", "content": "Cmd + ]" },
    { "type": "text", "tips": "后退一页（用方向键）", "content": "Cmd + Left" },
    { "type": "text", "tips": "前进一页（用方向键）", "content": "Cmd + Right" },
    { "type": "text", "tips": "停止加载网页", "content": "Esc" },
    { "type": "text", "tips": "新建一封带当前网页链接的邮件", "content": "Cmd + Shift + I" }
  ]
}
