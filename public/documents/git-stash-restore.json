{
  "title": "Git 暂存与撤销 (Stash & Restore)",
  "description": "Git 系列变更恢复：stash、restore、reset、revert、reflog，覆盖临时保存与撤销操作",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "暂存当前工作区修改", "content": "git stash" },
    { "type": "text", "tips": "暂存并包含未跟踪文件", "content": "git stash push -u -m \"temp build\"" },
    { "type": "text", "tips": "列出所有暂存记录", "content": "git stash list" },
    { "type": "text", "tips": "恢复最近暂存并删除记录", "content": "git stash pop" },
    { "type": "text", "tips": "恢复指定暂存(保留记录)", "content": "git stash apply stash@{0}" },
    { "type": "text", "tips": "删除指定暂存记录", "content": "git stash drop stash@{0}" },
    { "type": "text", "tips": "清除所有暂存记录", "content": "git stash clear" },
    { "type": "text", "tips": "丢弃工作区文件修改", "content": "git restore src/index.ts" },
    { "type": "text", "tips": "取消暂存(从暂存区移出)", "content": "git restore --staged src/index.ts" },
    { "type": "text", "tips": "撤销最近提交(保留修改)", "content": "git reset HEAD~1" },
    { "type": "text", "tips": "软重置(修改回到暂存区)", "content": "git reset --soft HEAD~1" },
    { "type": "text", "tips": "硬重置(丢弃所有修改)", "content": "git reset --hard HEAD~1" },
    { "type": "text", "tips": "创建反向提交来撤销变更", "content": "git revert abc1234" },
    { "type": "text", "tips": "查看所有操作历史(可恢复)", "content": "git reflog" }
  ]
}
