{
  "title": "Git 标签与发布 (Tag & Release)",
  "description": "Git 系列发布流程：创建、删除、查看、推送 tag，并练习检出指定版本标签",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "列出所有标签", "content": "git tag" },
    { "type": "text", "tips": "创建轻量标签", "content": "git tag v1.0.0" },
    { "type": "text", "tips": "创建带注释的标签", "content": "git tag -a v1.0.0 -m \"Release version 1.0.0\"" },
    { "type": "text", "tips": "为指定提交打标签", "content": "git tag -a v1.0.0 abc1234" },
    { "type": "text", "tips": "删除本地标签", "content": "git tag -d v1.0.0" },
    { "type": "text", "tips": "查看标签详细信息", "content": "git show v1.0.0" },
    { "type": "text", "tips": "推送指定标签到远程", "content": "git push origin v1.0.0" },
    { "type": "text", "tips": "推送所有标签到远程", "content": "git push origin --tags" },
    { "type": "text", "tips": "删除远程标签", "content": "git push origin --delete v1.0.0" },
    { "type": "text", "tips": "检出标签对应的代码", "content": "git checkout v1.0.0" }
  ]
}
