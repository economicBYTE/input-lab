{
  "title": "Git 标签与发布 (Tag & Release)",
  "description": "Git 系列发布流程：创建、删除、查看、推送 tag，并练习检出指定版本标签",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "列出所有标签", "content": "git tag" },
    { "type": "text", "tips": "创建轻量标签 v1.0.0", "content": "git tag v1.0.0" },
    { "type": "text", "tips": "创建带注释标签 v1.0.0，注释为 release v1.0.0", "content": "git tag -a v1.0.0 -m \"release v1.0.0\"" },
    { "type": "text", "tips": "给提交 abc123 打带注释标签 v1.0.0（不写注释内容）", "content": "git tag -a v1.0.0 abc123" },
    { "type": "text", "tips": "删除本地标签 v1.0.0", "content": "git tag -d v1.0.0" },
    { "type": "text", "tips": "查看标签 v1.0.0 的详情", "content": "git show v1.0.0" },
    { "type": "text", "tips": "推送标签 v1.0.0 到 origin", "content": "git push origin v1.0.0" },
    { "type": "text", "tips": "推送所有标签到 origin", "content": "git push origin --tags" },
    { "type": "text", "tips": "删除 origin 上的标签 v1.0.0", "content": "git push origin --delete v1.0.0" },
    { "type": "text", "tips": "检出标签 v1.0.0 对应的代码", "content": "git checkout v1.0.0" }
  ]
}
