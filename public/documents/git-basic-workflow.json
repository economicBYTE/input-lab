{
  "title": "Git 日常工作流 (Basic Workflow)",
  "description": "Git 系列日常高频：init/clone、status/add/commit、remote、push/pull/fetch 等基础协作流程",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "在当前目录初始化仓库", "content": "git init" },
    { "type": "text", "tips": "克隆仓库 git@github.com:u/repo.git", "content": "git clone git@github.com:u/repo.git" },
    { "type": "text", "tips": "浅克隆 git@github.com:u/repo.git，只取最近 1 次提交", "content": "git clone --depth 1 git@github.com:u/repo.git" },
    { "type": "text", "tips": "查看工作区状态", "content": "git status" },
    { "type": "text", "tips": "暂存所有变更", "content": "git add ." },
    { "type": "text", "tips": "交互式逐块选择要暂存的内容", "content": "git add -p" },
    { "type": "text", "tips": "用 git 把 a.ts 重命名为 b.ts", "content": "git mv a.ts b.ts" },
    { "type": "text", "tips": "从版本控制中删除文件 a.ts", "content": "git rm a.ts" },
    { "type": "text", "tips": "提交，信息为 feat: login", "content": "git commit -m \"feat: login\"" },
    { "type": "text", "tips": "创建空提交触发 CI，信息为 chore: ci", "content": "git commit --allow-empty -m \"chore: ci\"" },
    { "type": "text", "tips": "修改最近一次提交（打开编辑器）", "content": "git commit --amend" },
    { "type": "text", "tips": "添加远程 origin 指向 git@github.com:u/repo.git", "content": "git remote add origin git@github.com:u/repo.git" },
    { "type": "text", "tips": "把 origin 的地址改为 git@github.com:u/new.git", "content": "git remote set-url origin git@github.com:u/new.git" },
    { "type": "text", "tips": "查看远程仓库地址", "content": "git remote -v" },
    { "type": "text", "tips": "首次推送 main 到 origin 并设置上游", "content": "git push -u origin main" },
    { "type": "text", "tips": "让当前分支追踪 origin/main（用 branch 命令）", "content": "git branch --set-upstream-to=origin/main" },
    { "type": "text", "tips": "推送 main 到 origin", "content": "git push origin main" },
    { "type": "text", "tips": "安全强推（远程有他人提交就失败）", "content": "git push --force-with-lease" },
    { "type": "text", "tips": "拉取 origin 的 main 并合并", "content": "git pull origin main" },
    { "type": "text", "tips": "以 rebase 方式拉取 origin 的 main", "content": "git pull --rebase origin main" },
    { "type": "text", "tips": "只获取 origin 的更新，不合并", "content": "git fetch origin" },
    { "type": "text", "tips": "获取远程更新并清理已删除的远程分支", "content": "git fetch --prune" }
  ]
}
