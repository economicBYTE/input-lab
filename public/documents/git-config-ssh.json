{
  "title": "Git Config & SSH Setup",
  "description": "Git global config, SSH key generation, and GitHub authentication",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "设置全局用户名", "content": "git config --global user.name \"your_username\"" },
    { "type": "text", "tips": "设置全局邮箱", "content": "git config --global user.email \"your_email@example.com\"" },
    { "type": "text", "tips": "设置默认编辑器为vim", "content": "git config --global core.editor \"vim\"" },
    { "type": "text", "tips": "设置默认分支名为main", "content": "git config --global init.defaultBranch main" },
    { "type": "text", "tips": "查看所有配置项", "content": "git config --list" },
    { "type": "text", "tips": "查看已有SSH密钥", "content": "ls -al ~/.ssh" },
    { "type": "text", "tips": "生成ed25519 SSH密钥", "content": "ssh-keygen -t ed25519 -C \"your_email@example.com\"" },
    { "type": "text", "tips": "启动SSH代理", "content": "eval \"$(ssh-agent -s)\"" },
    { "type": "text", "tips": "将私钥添加到SSH代理", "content": "ssh-add ~/.ssh/id_ed25519" },
    { "type": "text", "tips": "查看公钥(复制到GitHub)", "content": "cat ~/.ssh/id_ed25519.pub" },
    { "type": "text", "tips": "测试GitHub SSH连接", "content": "ssh -T git@github.com" }
  ]
}
