{
  "title": "Claude Code CLI Commands",
  "description": "Claude Code CLI core commands and essential flags for daily use",
  "category": "Claude Code",
  "content": [
    { "type": "text", "tips": "启动交互式会话", "content": "claude" },
    { "type": "text", "tips": "带初始提示 explain this repo 启动会话", "content": "claude \"explain this repo\"" },
    { "type": "text", "tips": "单次查询模式（不进交互），提示 explain this", "content": "claude -p \"explain this\"" },
    { "type": "text", "tips": "把 a.log 通过管道交给单次查询，提示 explain", "content": "cat a.log | claude -p \"explain\"" },
    { "type": "text", "tips": "继续最近一次对话", "content": "claude -c" },
    { "type": "text", "tips": "继续最近对话并用单次模式，提示 check types", "content": "claude -c -p \"check types\"" },
    { "type": "text", "tips": "恢复名为 auth 的会话并发送 finish it", "content": "claude -r \"auth\" \"finish it\"" },
    { "type": "text", "tips": "更新 Claude Code", "content": "claude update" },
    { "type": "text", "tips": "查看版本号（用短参数 -v）", "content": "claude -v" },
    { "type": "text", "tips": "登录 Anthropic 账户", "content": "claude auth login" },
    { "type": "text", "tips": "用邮箱 tom@a.com 并走 SSO 登录", "content": "claude auth login --email tom@a.com --sso" },
    { "type": "text", "tips": "登出账户", "content": "claude auth logout" },
    { "type": "text", "tips": "查看认证状态", "content": "claude auth status" },
    { "type": "text", "tips": "列出所有子代理", "content": "claude agents" },
    { "type": "text", "tips": "配置 MCP 服务器", "content": "claude mcp" },
    { "type": "text", "tips": "启动远程控制会话", "content": "claude remote-control" },
    { "type": "text", "tips": "指定模型 claude-sonnet-5 运行", "content": "claude --model claude-sonnet-5" },
    { "type": "text", "tips": "额外添加工作目录 ../a 和 ../b", "content": "claude --add-dir ../a ../b" },
    { "type": "text", "tips": "使用名为 my-agent 的代理", "content": "claude --agent my-agent" },
    { "type": "text", "tips": "以 plan 权限模式启动（只读不写）", "content": "claude --permission-mode plan" },
    { "type": "text", "tips": "把可用工具限制为 Bash,Edit,Read", "content": "claude --tools \"Bash,Edit,Read\"" },
    { "type": "text", "tips": "预授权 Bash(git log *) 和 Read 两个工具", "content": "claude --allowedTools \"Bash(git log *)\" \"Read\"" },
    { "type": "text", "tips": "单次查询 hi，输出格式设为 json", "content": "claude -p \"hi\" --output-format json" },
    { "type": "text", "tips": "单次模式指定输出格式 stream-json，再跟提示 hi", "content": "claude -p --output-format stream-json \"hi\"" },
    { "type": "text", "tips": "单次模式限制最大花费 5.00 美元，再跟提示 hi", "content": "claude -p --max-budget-usd 5.00 \"hi\"" },
    { "type": "text", "tips": "单次模式限制最多 3 轮，再跟提示 hi", "content": "claude -p --max-turns 3 \"hi\"" },
    { "type": "text", "tips": "加载 MCP 配置文件 ./mcp.json", "content": "claude --mcp-config ./mcp.json" },
    { "type": "text", "tips": "在默认系统提示后追加 use TypeScript", "content": "claude --append-system-prompt \"use TypeScript\"" },
    { "type": "text", "tips": "整个替换系统提示为 be concise", "content": "claude --system-prompt \"be concise\"" },
    { "type": "text", "tips": "从文件 ./p.txt 加载系统提示", "content": "claude --system-prompt-file ./p.txt" },
    { "type": "text", "tips": "在 git worktree dev 中隔离运行（用短参数 -w）", "content": "claude -w dev" },
    { "type": "text", "tips": "恢复 PR 123 关联的会话", "content": "claude --from-pr 123" },
    { "type": "text", "tips": "开启调试并只看 api,mcp 两类日志", "content": "claude --debug \"api,mcp\"" },
    { "type": "text", "tips": "启用详细日志", "content": "claude --verbose" },
    { "type": "text", "tips": "创建远程会话，任务为 fix login", "content": "claude --remote \"fix login\"" },
    { "type": "text", "tips": "把远程会话回传到本地", "content": "claude --teleport" },
    { "type": "text", "tips": "启用 Chrome 浏览器集成", "content": "claude --chrome" },
    { "type": "text", "tips": "单次模式设置回退模型为 sonnet，再跟提示 hi", "content": "claude -p --fallback-model sonnet \"hi\"" }
  ]
}
