{
  "title": "Git 速查总览 (Quick Reference)",
  "description": "Git 系列总览：覆盖配置、初始化、提交、远程、分支、差异、撤销、stash 与 tag 的高频命令，适合先建立整体手感",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "设置全局用户名", "content": "git config --global user.name \"your_name\"" },
    { "type": "text", "tips": "设置全局邮箱", "content": "git config --global user.email \"you@example.com\"" },
    { "type": "text", "tips": "初始化仓库", "content": "git init" },
    { "type": "text", "tips": "克隆远程仓库", "content": "git clone git@github.com:user/repo.git" },
    { "type": "text", "tips": "查看工作区状态", "content": "git status" },
    { "type": "text", "tips": "暂存所有变更", "content": "git add ." },
    { "type": "text", "tips": "暂存指定文件", "content": "git add src/index.ts" },
    { "type": "text", "tips": "取消暂存指定文件", "content": "git restore --staged src/index.ts" },
    { "type": "text", "tips": "提交并附带消息", "content": "git commit -m \"feat: add user login\"" },
    { "type": "text", "tips": "修改最近一次提交", "content": "git commit --amend" },
    { "type": "text", "tips": "查看远程仓库信息", "content": "git remote -v" },
    { "type": "text", "tips": "添加远程仓库", "content": "git remote add origin git@github.com:user/repo.git" },
    { "type": "text", "tips": "首次推送并设置上游", "content": "git push -u origin main" },
    { "type": "text", "tips": "推送到远程主分支", "content": "git push origin main" },
    { "type": "text", "tips": "拉取远程主分支", "content": "git pull origin main" },
    { "type": "text", "tips": "获取远程更新并清理已删除分支", "content": "git fetch --prune" },
    { "type": "text", "tips": "列出本地分支", "content": "git branch" },
    { "type": "text", "tips": "切换到main分支", "content": "git switch main" },
    { "type": "text", "tips": "创建并切换到新分支", "content": "git switch -c feature/login" },
    { "type": "text", "tips": "合并分支到当前分支", "content": "git merge feature/login" },
    { "type": "text", "tips": "删除已合并的本地分支", "content": "git branch -d feature/login" },
    { "type": "text", "tips": "删除远程分支", "content": "git push origin --delete feature/login" },
    { "type": "text", "tips": "图形化查看所有分支日志", "content": "git log --oneline --graph --all" },
    { "type": "text", "tips": "查看工作区未暂存的差异", "content": "git diff" },
    { "type": "text", "tips": "查看已暂存的差异", "content": "git diff --staged" },
    { "type": "text", "tips": "查看最新提交的详情", "content": "git show HEAD" },
    { "type": "text", "tips": "丢弃工作区文件修改", "content": "git restore src/index.ts" },
    { "type": "text", "tips": "软重置(保留修改到暂存区)", "content": "git reset --soft HEAD~1" },
    { "type": "text", "tips": "创建反向提交撤销变更", "content": "git revert abc1234" },
    { "type": "text", "tips": "暂存当前修改", "content": "git stash" },
    { "type": "text", "tips": "恢复最近暂存的修改", "content": "git stash pop" },
    { "type": "text", "tips": "创建带注释的标签", "content": "git tag -a v1.0.0 -m \"release v1.0.0\"" }
  ]
}
