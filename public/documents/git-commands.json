{
  "title": "Git 速查总览 (Quick Reference)",
  "description": "Git 系列总览：覆盖配置、初始化、提交、远程、分支、差异、撤销、stash 与 tag 的高频命令，适合先建立整体手感",
  "category": "Git",
  "content": [
    { "type": "text", "tips": "设置全局用户名为 tom", "content": "git config --global user.name \"tom\"" },
    { "type": "text", "tips": "设置全局邮箱为 tom@a.com", "content": "git config --global user.email \"tom@a.com\"" },
    { "type": "text", "tips": "在当前目录初始化仓库", "content": "git init" },
    { "type": "text", "tips": "克隆仓库 git@github.com:u/repo.git", "content": "git clone git@github.com:u/repo.git" },
    { "type": "text", "tips": "查看工作区状态", "content": "git status" },
    { "type": "text", "tips": "暂存所有变更", "content": "git add ." },
    { "type": "text", "tips": "只暂存文件 a.ts", "content": "git add a.ts" },
    { "type": "text", "tips": "把 a.ts 从暂存区移出（用 restore）", "content": "git restore --staged a.ts" },
    { "type": "text", "tips": "提交，信息为 feat: login", "content": "git commit -m \"feat: login\"" },
    { "type": "text", "tips": "修改最近一次提交（打开编辑器）", "content": "git commit --amend" },
    { "type": "text", "tips": "查看远程仓库地址", "content": "git remote -v" },
    { "type": "text", "tips": "添加远程 origin 指向 git@github.com:u/repo.git", "content": "git remote add origin git@github.com:u/repo.git" },
    { "type": "text", "tips": "首次推送 main 到 origin 并设置上游", "content": "git push -u origin main" },
    { "type": "text", "tips": "推送 main 到 origin", "content": "git push origin main" },
    { "type": "text", "tips": "拉取 origin 的 main 并合并", "content": "git pull origin main" },
    { "type": "text", "tips": "获取远程更新并清理已删除的远程分支", "content": "git fetch --prune" },
    { "type": "text", "tips": "列出本地分支", "content": "git branch" },
    { "type": "text", "tips": "用 switch 切换到 main 分支", "content": "git switch main" },
    { "type": "text", "tips": "用 switch 创建并切换到 dev 分支", "content": "git switch -c dev" },
    { "type": "text", "tips": "把 dev 合并到当前分支", "content": "git merge dev" },
    { "type": "text", "tips": "删除已合并的本地分支 dev", "content": "git branch -d dev" },
    { "type": "text", "tips": "删除 origin 上的远程分支 dev", "content": "git push origin --delete dev" },
    { "type": "text", "tips": "单行 + 图形化查看所有分支日志", "content": "git log --oneline --graph --all" },
    { "type": "text", "tips": "查看工作区未暂存的差异", "content": "git diff" },
    { "type": "text", "tips": "查看已暂存的差异", "content": "git diff --staged" },
    { "type": "text", "tips": "查看 HEAD 提交的详情", "content": "git show HEAD" },
    { "type": "text", "tips": "丢弃 a.ts 的工作区修改", "content": "git restore a.ts" },
    { "type": "text", "tips": "软重置到上一个提交（改动留在暂存区）", "content": "git reset --soft HEAD~1" },
    { "type": "text", "tips": "创建反向提交撤销 abc123", "content": "git revert abc123" },
    { "type": "text", "tips": "把当前修改存进 stash", "content": "git stash" },
    { "type": "text", "tips": "恢复最近的 stash 并删除该记录", "content": "git stash pop" },
    { "type": "text", "tips": "创建带注释标签 v1.0.0，注释为 release v1.0.0", "content": "git tag -a v1.0.0 -m \"release v1.0.0\"" }
  ]
}
