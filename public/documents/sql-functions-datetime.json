{
  "title": "SQL 日期时间函数 (Date & Time)",
  "description": "SQL 工作流系列 (6/16)：NOW、DATE_FORMAT、DATE_ADD、YEAR/MONTH、UNIX_TIMESTAMP 等日期时间处理函数",
  "category": "SQL",
  "caseInsensitive": true,
  "content": [
    { "type": "text", "tips": "取当前日期时间（用 NOW）", "content": "SELECT NOW();" },
    { "type": "text", "tips": "取当前日期（用 CURDATE）", "content": "SELECT CURDATE();" },
    { "type": "text", "tips": "取当前时间（用 CURTIME）", "content": "SELECT CURTIME();" },
    { "type": "text", "tips": "把 NOW() 格式化成 %Y-%m-%d %H:%i:%s", "content": "SELECT DATE_FORMAT(NOW(), '%Y-%m-%d %H:%i:%s');" },
    { "type": "text", "tips": "把 orders 的 created_at 格式化成 %Y/%m/%d", "content": "SELECT DATE_FORMAT(created_at, '%Y/%m/%d') FROM orders;" },
    { "type": "text", "tips": "在 NOW() 上加 7 天（用 DATE_ADD）", "content": "SELECT DATE_ADD(NOW(), INTERVAL 7 DAY);" },
    { "type": "text", "tips": "在 2026-04-14 上加 1 个月（用 DATE_ADD）", "content": "SELECT DATE_ADD('2026-04-14', INTERVAL 1 MONTH);" },
    { "type": "text", "tips": "在 CURDATE() 上减 30 天（用 DATE_SUB）", "content": "SELECT DATE_SUB(CURDATE(), INTERVAL 30 DAY);" },
    { "type": "text", "tips": "求 2026-12-31 与 2026-01-01 相差天数", "content": "SELECT DATEDIFF('2026-12-31', '2026-01-01');" },
    { "type": "text", "tips": "提取 orders 中 created_at 的年份", "content": "SELECT YEAR(created_at) FROM orders;" },
    { "type": "text", "tips": "提取 2026-04-14 的月份", "content": "SELECT MONTH('2026-04-14');" },
    { "type": "text", "tips": "提取 NOW() 的日", "content": "SELECT DAY(NOW());" },
    { "type": "text", "tips": "用 EXTRACT 从 NOW() 提取 YEAR", "content": "SELECT EXTRACT(YEAR FROM NOW());" },
    { "type": "text", "tips": "把 2026-04-14 12:00:00 转成时间戳", "content": "SELECT UNIX_TIMESTAMP('2026-04-14 12:00:00');" },
    { "type": "text", "tips": "把时间戳 1700000000 转回日期时间", "content": "SELECT FROM_UNIXTIME(1700000000);" }
  ]
}
